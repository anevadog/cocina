# Entorno de la demo pública de solo lectura (ADR-047).
#
# Copiar a `.env.demo` en el VPS, completar y dar permisos: chmod 600 .env.demo
# Generar secretos con: openssl rand -base64 48
#
# La base es desechable: solo contiene datos ficticios del seed `demo`. Aun así, la
# contraseña de PostgreSQL y el secreto JWT no deben ser los de desarrollo.

# --- Proxy y TLS ---
SITE_ADDRESS=demo.example.com
ACME_EMAIL=admin@example.com

# --- Aplicación ---
APP_VERSION=demo
# Documentación apagada: el panel no la necesita y no se expone la superficie completa.
API_DOCS_ENABLED=false

# --- PostgreSQL ---
POSTGRES_DB=cocina_demo
POSTGRES_USER=cocina_demo
POSTGRES_PASSWORD=

# --- Seguridad ---
# Obligatorio: mínimo 32 bytes. Distinto del de producción.
JWT_SECRET=
# Contraseña de los usuarios demo.* (el panel usa demo.manager).
COCINA_DEMO_PASSWORD=

# --- Recursos (VPS de 2 GB de referencia) ---
DB_MEMORY_LIMIT=512M
API_MEMORY_LIMIT=768M
