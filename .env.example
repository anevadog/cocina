# Copiar a .env y ajustar en local. Nunca commitear .env ni valores reales.

# --- Aplicación ---
SPRING_PROFILES_ACTIVE=local
APP_TIMEZONE=Europe/Madrid
SERVER_PORT=8080

# --- PostgreSQL (contenedor) ---
# El contenedor se publica en 5433 para no chocar con un PostgreSQL nativo en 5432.
POSTGRES_DB=cocina
POSTGRES_USER=cocina
POSTGRES_PASSWORD=cambiar_en_local
DB_HOST=localhost
DB_PORT=5433

# --- Seguridad ---
# Obligatorio en cualquier perfil que no sea local/test: la API no arranca sin él.
# Generar con: openssl rand -base64 48
JWT_SECRET=cambiar_en_local
# Duración de los tokens: notación de Spring (15m, 30d). El acceso nunca puede pasar de 15m.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Arranque ---
# Establecimiento activo (el MVP atiende uno solo).
ESTABLISHMENT_ID=1
ESTABLISHMENT_NAME=Cocina
# Primer administrador: solo se crea si no existe ningún usuario y hay contraseña.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=cambiar_en_local

# --- Datos de demostración (perfil "demo") ---
# Solo se siembran si la base está vacía: ver README y docs/backups.md.
# Perfil: SPRING_PROFILES_ACTIVE=local,demo
# Contraseña de demo.admin, demo.manager, demo.cook y demo.store (mínimo 12 caracteres).
# Se exporta en el entorno del proceso; este archivo .env solo lo lee Docker Compose.
COCINA_DEMO_PASSWORD=Demo2026!segura

# --- Inventario ---
# Días de antelación con los que un lote entra en la alerta de caducidad.
INVENTORY_EXPIRY_WARNING_DAYS=3

# --- CORS (futuro frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
