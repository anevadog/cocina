# Plantilla del entorno de producción (NFR-POR-01, NFR-SEG-04).
#
# Copiar a `.env` en el VPS y completar los valores. `.env` está ignorado por Git y no debe
# salir nunca del servidor. Permisos recomendados: chmod 600 .env
#
# Generar secretos con: openssl rand -base64 48

# --- Proxy y TLS ---
# Dominio con registro A/AAAA apuntando al VPS. Caddy obtiene el certificado solo.
SITE_ADDRESS=cocina.example.com
# Correo real para el aviso de expiración de Let's Encrypt.
ACME_EMAIL=admin@example.com

# --- Aplicación ---
APP_VERSION=0.1.0
APP_TIMEZONE=Europe/Madrid
# La documentación se apaga en producción. Activar solo de forma temporal y consciente.
API_DOCS_ENABLED=false
# Hilos y conexiones: ajustar al tamaño del VPS, no al número de empleados.
SERVER_MAX_THREADS=50
SERVER_MAX_CONNECTIONS=200

# --- PostgreSQL ---
POSTGRES_DB=cocina
POSTGRES_USER=cocina
POSTGRES_PASSWORD=
# La API y la base se comunican por la red interna de Compose.
DB_HOST=db
DB_PORT=5432
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
# Límites de memoria de los contenedores (2 GB de VPS como referencia).
DB_MEMORY_LIMIT=512M
API_MEMORY_LIMIT=768M

# --- Seguridad ---
# Obligatorio: mínimo 32 bytes. La API no arranca sin él.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Arranque ---
ESTABLISHMENT_ID=1
ESTABLISHMENT_NAME=Cocina
# Primer administrador: solo se crea si no existe ningún usuario y hay contraseña.
# Tras el primer arranque conviene vaciar esta variable.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- Inventario ---
INVENTORY_EXPIRY_WARNING_DAYS=3

# --- Copias de seguridad ---
# Directorio local de volcados y retención (scripts/backup.sh).
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
# Remoto de rclone para la copia externa (scripts/backup-offsite.sh).
# Ejemplo: s3:cocina-backups. Dejar vacío si aún no hay copia externa.
RCLONE_REMOTE=
